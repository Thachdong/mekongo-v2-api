enum EAccountStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

model Account {
  id           String    @id @default(uuid())
  phone        String?   @unique
  email        String?   @unique
  passwordHash String
  status       EAccountStatus    @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profiles     Profile[]
  refreshTokens RefreshToken[]
}