enum EAccountStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

model Account {
  id            String         @id @default(uuid())
  phone         String?        @unique
  email         String?        @unique
  passwordHash  String
  status        EAccountStatus @default(ACTIVE)

  // Shared across every profile type — not specific to any one "role".
  displayName   String?
  avatarUrl     String?
  trustScore    Int            @default(100)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  addresses     Address[]
  profiles      Profile[]
  refreshTokens RefreshToken[]
  otpRequests   OtpRequest[]
}
