enum EProfileType {
  INDIVIDUAL
}

model Profile {
  id        String       @id @default(uuid())
  accountId String
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      EProfileType @default(INDIVIDUAL)

  // Only one profile per account can be active at a time (app-layer invariant,
  // same pattern as Address.isDefault below).
  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  comments Comment[]

  @@unique([accountId, type])
}
